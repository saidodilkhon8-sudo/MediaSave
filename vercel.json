{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "python",
      "config": {
        "maxLambdaSize": "500MB"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.12"
  }
}
